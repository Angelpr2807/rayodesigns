<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="pgrad2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:rgb(74, 222, 128);stop-opacity:1" />
      <stop offset="100%" style="stop-color:rgb(34, 197, 94);stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="url(#pgrad2)"/>
  <text x="400" y="250" font-size="100" font-weight="bold" text-anchor="middle" fill="white" font-family="Arial">EcoPack</text>
  <text x="400" y="350" font-size="50" text-anchor="middle" fill="rgba(255,255,255,0.7)" font-family="Arial">Sustainable</text>
  <text x="400" y="450" font-size="20" text-anchor="middle" fill="rgba(255,255,255,0.5)" font-family="Arial, sans-serif">Packaging • Diseño Ecológico</text>
</svg>